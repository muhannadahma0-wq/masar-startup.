# Set this on the web build service to point to the deployed Masar API.
VITE_API_BASE_URL=https://your-api-service.onrender.com
# Supabase Auth client (the publishable key is intentionally public; never use service_role here).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-your-publishable-key
