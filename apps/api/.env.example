PORT=4000
WEB_ORIGIN=http://localhost:5173
MAX_FILE_SIZE_MB=20
PITCH_ANALYZER_URL=http://127.0.0.1:8000/internal/analyze
PITCH_SERVICE_TOKEN=replace-with-a-long-random-secret
# Set NODE_ENV=production in deployed environments.
# Optional server-side Supabase REST fallback (publishable key only; never use service_role here).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-your-publishable-key
